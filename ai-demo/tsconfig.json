{
  "compilerOptions": {
//    "target": "es2016",
//    "module": "commonjs",
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "outDir": "dist"
  },
  "include": ["src", "tests"]
}
